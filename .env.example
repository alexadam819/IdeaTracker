# Copy this file to .env and fill in your values.

# Configure at least one LLM provider for AI research:

# Option A: Google Gemini (supports Google Search grounding)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: defaults to gemini-flash-latest
GEMINI_MODEL=

# Option B: Anthropic Claude
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: defaults to claude-3-5-sonnet-20241022 (or claude-3-5-haiku-20241022, claude-3-7-sonnet-20250219)
ANTHROPIC_MODEL=
# Optional: workspace ID (e.g. wrkspc_...) if your API key is organization-scoped without a default workspace
ANTHROPIC_WORKSPACE_ID=

# Optional. Force provider when both keys are set: 'gemini' or 'claude'
LLM_PROVIDER=

# Optional. Port for the web server (defaults to 3000).
PORT=3000
